{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["snapshot", "nodes", "nextCursor"],
  "properties": {
    "snapshot": { "type": "object" },
    "nodes": { "type": "array", "items": { "type": "object", "required": ["nodeId", "name", "nodeType", "pathIds", "depth"] } },
    "nextCursor": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
